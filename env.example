# 复制为 .env 后填入真实值
# cp .env.example .env

# ── Anthropic Claude API ─────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 邮件发送配置 ─────────────────────────────
# Gmail 用户：先在 Google 账号开启"两步验证"
# 再生成"应用专用密码"：myaccount.google.com/apppasswords
EMAIL_ADDRESS=yourname@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx   # 16位应用专用密码

# 接收摘要的邮箱 —— 支持多个收件人，用英文逗号分隔
# 单个收件人：
EMAIL_TO=yourname@gmail.com
# 多个收件人（取消注释并替换）：
# EMAIL_TO=you@gmail.com,colleague@qq.com,lab@163.com

# ── 可选：自定义 SMTP（默认 Gmail）────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
